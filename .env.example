# =============================================================================
# SMARTLINK BUSINESS — SERVER & SECURE EMAIL CONFIGURATION
# =============================================================================
# Update the variables below with your email and SMTP credentials.
# Then start the server with:
#   powershell -ExecutionPolicy Bypass -File server.ps1
# =============================================================================

# Server Port
PORT=3000

# 1. Your Email Address where customer enquiries will be delivered:
NOTIFICATION_EMAIL=your_email@gmail.com

# 2. SMTP Provider Settings:
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_char_google_app_password
#
# (Note: For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords)
#
# Example for Resend / SendGrid / Brevo:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# 3. Sender Display Email (Optional, defaults to SMTP_USER):
FROM_EMAIL=your_email@gmail.com

{
  "version": 2,
  "routes": [
    {
      "src": "/api/send-enquiry",
      "dest": "/api/send-enquiry.js"
    },
    {
      "src": "/api/proxy-render",
      "dest": "/api/proxy-render.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
